# Python bytecode — never commit, anywhere in the tree
__pycache__/
*.py[cod]

# Runtime outputs: per-video analysis artifacts and downloaded videos
/analysis_results/
/videos/
*.mp4

# Vendored SGDepth (external weights/code, kept out of this repo)
/modules/sidewalk/SGDepth

# large tracking-pass detector weight (auto-downloaded on first run)
yolo11x.pt

# SGDepth sidewalk weights (146 MB, gdown 1X1uKa... per README)
modules/sidewalk/weights/

# pose weights (118 MB, auto-downloaded by ultralytics)
yolo11x-pose.pt
yolo11*-pose.pt

# YouTube cookie jar: yt-dlp rewrites it on every run (rotating anonymous consent/visitor
# cookies), so tracking it dirties the repo after each batch. Keep it local per machine.
www.youtube.com_cookies.txt
/osm_localization_cache
